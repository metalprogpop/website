{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "set-role": "node --import tsx src/scripts/set-role.ts",
    "import-sheet": "node --import tsx src/scripts/import-sheet.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "drizzle-orm": "0.31.4",
    "express": "4.22.1",
    "express-rate-limit": "8.5.1",
    "fast-xml-parser": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "postgres": "3.4.8",
    "resend": "6.9.3",
    "sanitize-html": "2.17.7",
    "shared": "workspace:*",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.19.7",
    "@types/sanitize-html": "2.16.2",
    "drizzle-kit": "0.22.8",
    "read-excel-file": "9.3.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
