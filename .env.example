DATABASE_URL=postgresql://dev:dev@db:5432/app

# Dev-only auth flags. Leave unset/false in production.
TEST_USERS_ENABLED=true
TEST_USER_EMAILS=test@example.com
DEV_SHOW_MAGIC_LINK=true
VITE_TEST_USERS_ENABLED=true
VITE_DEV_SHOW_MAGIC_LINK=true

# Optional in dev. Real Resend send only when set + DEV_SHOW_MAGIC_LINK=false.
RESEND_API_KEY=

# Uncomment to reach the dev site from other devices on the local network, at
# http://<this machine's IP>:9001. Leave it off on untrusted networks.
# DEV_HOST=0.0.0.0
